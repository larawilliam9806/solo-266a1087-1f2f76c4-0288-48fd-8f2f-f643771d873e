# Copy to `.env` and adjust; docker compose reads `.env` automatically.
# Host port published for the service (container always listens on 8000).
HOST_PORT=8000

# Idle-with-work collection window (milliseconds).
BATCH_WINDOW_MS=20

# Element budget per padded batch: batch_size * max_sequence_length.
MAX_ELEMENTS=4096

# Budget accounting: padded (batch*max_len) or sum (sum of true lengths).
BUDGET_MODE=padded

# Greedy fit policy: skip (try later requests) or prefix (stop at first miss).
PACK_POLICY=skip

# 0 = unlimited number of requests per batch (element budget still applies).
MAX_BATCH_SIZE=0

# Default caller deadline when timeout_ms is omitted.
DEFAULT_TIMEOUT_MS=5000

# HTTP status codes used for deadline / over-budget outcomes.
TIMEOUT_STATUS_CODE=408
TOO_LARGE_STATUS_CODE=413

# Optional artificial per-batch inference latency (ms), useful for observing
# deadline / single-flight behavior. 0 disables it.
INFERENCE_DELAY_MS=0
